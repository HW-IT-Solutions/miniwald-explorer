{% block miniwald_species_list %}
<sw-page class="miniwald-species-list miniwald-explorer-list">
    {% block miniwald_species_list_search_bar %}
    <template #search-bar>
        <sw-search-bar
            initial-search-type="miniwald_explorer_species"
            :initial-search="term"
            @search="onSearch"
        >
                </sw-search-bar>
    </template>
    {% endblock %}

    {% block miniwald_species_list_smart_bar_header %}
    <template #smart-bar-header>
        <h2>
            {{ $tc('miniwald-explorer.species.list.title') }}
        </h2>
    </template>
    {% endblock %}

    {% block miniwald_species_list_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block miniwald_species_list_smart_bar_actions_add %}
        <sw-button
            :router-link="{ name: 'miniwald.explorer.species.detail', params: { id: 'create' } }"
            variant="primary"
        >
            {{ $tc('miniwald-explorer.species.list.buttonAdd') }}
        </sw-button>
        {% endblock %}
    </template>
    {% endblock %}

    {% block miniwald_species_list_language_switch %}
    <template #language-switch>
        <sw-language-switch @on-change="onChangeLanguage"></sw-language-switch>
    </template>
    {% endblock %}

    <template #content>
        {% block miniwald_species_list_content %}
        <div class="miniwald-species-list__content">
            {% block miniwald_species_list_grid %}
            <sw-entity-listing
                v-if="items"
                :items="items"
                :repository="entityRepository"
                :show-selection="true"
                :columns="columns"
                :is-loading="isLoading"
                detail-route="miniwald.explorer.species.detail"
                @inline-edit-save="onInlineEditSave"
            >
                {% block miniwald_species_list_grid_columns %}
                {% block miniwald_species_list_grid_columns_image %}
                <template #column-image="{ item }">
                    <sw-media-preview-v2
                        v-if="item.imageId"
                        :source="item.imageId"
                    >
                                        </sw-media-preview-v2>
                </template>
                {% endblock %}

                {% block miniwald_species_list_grid_columns_name %}
                <template #column-name="{ item }">
                    <router-link
                        :to="{ name: 'miniwald.explorer.species.detail', params: { id: item.id } }"
                    >
                        {{ item.translated.name || item.name }}
                    </router-link>
                </template>
                {% endblock %}

                {% block miniwald_species_list_grid_columns_category %}
                <template #column-speciesCategory.name="{ item }">
                    <template v-if="item.speciesCategory">
                        {{ item.speciesCategory.translated.name || item.speciesCategory.name }}
                    </template>
                </template>
                {% endblock %}

                {% block miniwald_species_list_grid_columns_active %}
                <template #column-active="{ item }">
                    <sw-icon
                        v-if="item.active"
                        name="regular-checkmark-xs"
                        small
                        :color="'#37d046'"
                    >
                                        </sw-icon>
                    <sw-icon
                        v-else
                        name="regular-times-s"
                        small
                        :color="'#de294c'"
                    >
                                        </sw-icon>
                </template>
                {% endblock %}
                {% endblock %}

                {% block miniwald_species_list_grid_action_modals %}
                <template #action-modals="{ item }">
                    {% block miniwald_species_list_delete_modal %}
                    <sw-modal
                        v-if="showDeleteModal === item.id"
                        @modal-close="onCloseDeleteModal"
                        :title="$tc('global.default.warning')"
                        variant="small"
                    >
                        <p class="miniwald-species-list__confirm-delete-text">
                            {{ $tc('miniwald-explorer.species.list.textDeleteConfirm', 0, { name: item.translated.name || item.name }) }}
                        </p>
                        <template #modal-footer>
                            <sw-button
                                @click="onCloseDeleteModal"
                                size="small"
                            >
                                {{ $tc('global.default.cancel') }}
                            </sw-button>
                            <sw-button
                                @click="onConfirmDelete(item.id)"
                                variant="danger"
                                size="small"
                            >
                                {{ $tc('global.default.delete') }}
                            </sw-button>
                        </template>
                    </sw-modal>
                    {% endblock %}
                </template>
                {% endblock %}
            </sw-entity-listing>
            {% endblock %}

            {% block miniwald_species_list_empty_state %}
            <sw-empty-state
                v-if="!isLoading && !total"
                :absolute="false"
                :title="$tc('miniwald-explorer.species.list.messageEmpty')"
            >
                        </sw-empty-state>
            {% endblock %}
        </div>
        {% endblock %}
    </template>
</sw-page>
{% endblock %}