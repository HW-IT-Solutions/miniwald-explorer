{% block miniwald_miniwald_list %}
<sw-page class="miniwald-miniwald-list miniwald-explorer-list">
    {% block miniwald_miniwald_list_search_bar %}
    <template #search-bar>
        <sw-search-bar
            initial-search-type="miniwald_explorer_miniwald"
            :initial-search="term"
            @search="onSearch"
        >
                </sw-search-bar>
    </template>
    {% endblock %}

    {% block miniwald_miniwald_list_smart_bar_header %}
    <template #smart-bar-header>
        <h2>
            {{ $tc('miniwald-explorer.miniwald.list.title') }}
        </h2>
    </template>
    {% endblock %}

    {% block miniwald_miniwald_list_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block miniwald_miniwald_list_smart_bar_actions_add %}
        <sw-button
            :router-link="{ name: 'miniwald.explorer.miniwald.detail', params: { id: 'create' } }"
            variant="primary"
        >
            {{ $tc('miniwald-explorer.miniwald.list.buttonAdd') }}
        </sw-button>
        {% endblock %}
    </template>
    {% endblock %}

    <template #content>
        {% block miniwald_miniwald_list_content %}
        <div class="miniwald-miniwald-list__content">
            {% block miniwald_miniwald_list_grid %}
            <sw-entity-listing
                v-if="items"
                :items="items"
                :repository="entityRepository"
                :show-selection="true"
                :columns="columns"
                :is-loading="isLoading"
                detail-route="miniwald.explorer.miniwald.detail"
                @inline-edit-save="onInlineEditSave"
            >
                {% block miniwald_miniwald_list_grid_columns %}
                {% block miniwald_miniwald_list_grid_columns_name %}
                <template #column-name="{ item }">
                    <router-link
                        :to="{ name: 'miniwald.explorer.miniwald.detail', params: { id: item.id } }"
                    >
                                            {{ item.name }}
                                        </router-link>
                </template>
                {% endblock %}
                {% endblock %}

                {% block miniwald_miniwald_list_grid_action_modals %}
                <template #action-modals="{ item }">
                    {% block miniwald_miniwald_list_delete_modal %}
                    <sw-modal
                        v-if="showDeleteModal === item.id"
                        @modal-close="onCloseDeleteModal"
                        :title="$tc('global.default.warning')"
                        variant="small"
                    >
                        <p class="miniwald-miniwald-list__confirm-delete-text">
                            {{ $tc('miniwald-explorer.miniwald.list.textDeleteConfirm', 0, { name: item.name }) }}
                        </p>
                        <template #modal-footer>
                            <sw-button
                                @click="onCloseDeleteModal"
                                size="small"
                            >
                                {{ $tc('global.default.cancel') }}
                            </sw-button>
                            <sw-button
                                @click="onConfirmDelete(item.id)"
                                variant="danger"
                                size="small"
                            >
                                {{ $tc('global.default.delete') }}
                            </sw-button>
                        </template>
                    </sw-modal>
                    {% endblock %}
                </template>
                {% endblock %}
            </sw-entity-listing>
            {% endblock %}

            {% block miniwald_miniwald_list_empty_state %}
            <sw-empty-state
                v-if="!isLoading && !total"
                :absolute="false"
                :title="$tc('miniwald-explorer.miniwald.list.messageEmpty')"
            >
                        </sw-empty-state>
            {% endblock %}
        </div>
        {% endblock %}
    </template>
</sw-page>
{% endblock %}