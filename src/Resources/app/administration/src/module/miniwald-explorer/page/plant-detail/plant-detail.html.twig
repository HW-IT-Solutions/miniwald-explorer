{% block miniwald_plant_detail %}
<sw-page class="miniwald-plant-detail">
    {% block miniwald_plant_detail_header %}
    <template #smart-bar-header>
        <h2 v-if="entity">
            {{ placeholder(entity, 'name', $tc('miniwald-explorer.plant.detail.textHeadline')) }}
        </h2>
        <h2 v-else>
            {{ $tc('miniwald-explorer.plant.detail.textHeadline') }}
        </h2>
    </template>
    {% endblock %}

    {% block miniwald_plant_detail_actions %}
    <template #smart-bar-actions>
        {% block miniwald_plant_detail_actions_abort %}
        <sw-button
            v-tooltip="tooltipCancel"
            @click="onClickCancel"
        >
            {{ $tc('miniwald-explorer.plant.detail.buttonCancel') }}
        </sw-button>
        {% endblock %}

        {% block miniwald_plant_detail_actions_save %}
        <sw-button-process
            v-tooltip="tooltipSave"
            class="miniwald-plant-detail__save-action"
            :is-loading="isLoading"
            :process-success="processSuccess"
            :disabled="isSaveDisabled"
            variant="primary"
            @process-finish="saveFinish"
            @click="onClickSave"
        >
            {{ $tc('miniwald-explorer.plant.detail.buttonSave') }}
        </sw-button-process>
        {% endblock %}
    </template>
    {% endblock %}

    {% block miniwald_plant_detail_content %}
    <template #content>
        <sw-card-view v-if="entity">
            {% block miniwald_plant_detail_content_general_card %}
            <sw-card
                :title="$tc('miniwald-explorer.plant.detail.cardTitleGeneral')"
                :is-loading="entityIsLoading"
            >
                <sw-container
                    columns="repeat(auto-fit, minmax(250px, 1fr))"
                    gap="0 30px"
                >
                    {% block miniwald_plant_detail_content_field_miniwald %}
                    <sw-entity-single-select
                        v-model:value="entity.miniwaldId"
                        entity="miniwald_explorer_miniwald"
                        :label="$tc('miniwald-explorer.plant.detail.labelMiniwald')"
                        :placeholder="$tc('miniwald-explorer.plant.detail.placeholderMiniwald')"
                        label-property="name"
                    >
                                    </sw-entity-single-select>
                    {% endblock %}

                    {% block miniwald_plant_detail_content_field_name %}
                    <sw-text-field
                        v-model:value="entity.name"
                        :label="$tc('miniwald-explorer.plant.detail.labelName')"
                        :placeholder="placeholder(entity, 'name', $tc('miniwald-explorer.plant.detail.placeholderName'))"
                        :error="entityNameError"
                        required
                    >
                                    </sw-text-field>
                    {% endblock %}

                    {% block miniwald_plant_detail_content_field_scientific_name %}
                    <sw-text-field
                        v-model:value="entity.scientificName"
                        :label="$tc('miniwald-explorer.plant.detail.labelScientificName')"
                        :placeholder="$tc('miniwald-explorer.plant.detail.placeholderScientificName')"
                    >
                                    </sw-text-field>
                    {% endblock %}

                    {% block miniwald_plant_detail_content_field_position %}
                    <sw-text-field
                        v-model:value="entity.position"
                        :label="$tc('miniwald-explorer.plant.detail.labelPosition')"
                        :placeholder="$tc('miniwald-explorer.plant.detail.placeholderPosition')"
                    >
                                    </sw-text-field>
                    {% endblock %}

                    {% block miniwald_plant_detail_content_field_sort_order %}
                    <sw-number-field
                        v-model:value="entity.sortOrder"
                        :label="$tc('miniwald-explorer.plant.detail.labelSortOrder')"
                        :placeholder="$tc('miniwald-explorer.plant.detail.placeholderSortOrder')"
                        numberType="int"
                        :min="0"
                    >
                                    </sw-number-field>
                    {% endblock %}

                    {% block miniwald_plant_detail_content_field_active %}
                    <sw-switch-field
                        v-model:value="entity.active"
                        :label="$tc('miniwald-explorer.plant.detail.labelActive')"
                    >
                                    </sw-switch-field>
                    {% endblock %}
                </sw-container>
            </sw-card>
            {% endblock %}

            {% block miniwald_plant_detail_content_media_card %}
            <sw-card
                :title="$tc('miniwald-explorer.plant.detail.cardTitleMedia')"
                :is-loading="entityIsLoading"
            >
                {% block miniwald_plant_detail_content_media_upload %}
                <sw-upload-listener
                    :upload-tag="entity.id"
                    auto-upload
                    @media-upload-finish="setMediaItem"
                >
                                </sw-upload-listener>

                <sw-media-upload-v2
                    variant="regular"
                    :upload-tag="entity.id"
                    :source="entity.imageId"
                    :allow-multi-select="false"
                    :label="$tc('miniwald-explorer.plant.detail.labelImage')"
                    :target-folder-id="plantMediaFolderId"
                    @sw-media-upload-v2-media-upload-success="setMediaItem"
                    @media-upload-add-file="onMediaUploadStart"
                    @media-drop="onDropMedia"
                    @media-upload-sidebar-open="showMediaModal = true"
                    @media-upload-remove-image="onUnlinkLogo"
                >
                                </sw-media-upload-v2>

                <sw-media-modal-v2
                    v-if="showMediaModal"
                    :allow-multi-select="false"
                    @modal-close="showMediaModal = false"
                    @media-modal-selection-change="onMediaSelectionChange"
                >
                                </sw-media-modal-v2>
                {% endblock %}
            </sw-card>
            {% endblock %}
        </sw-card-view>
        <sw-loader v-else></sw-loader>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}